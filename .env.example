# Copy to .env.local and fill in what you have. Every variable is optional;
# features degrade gracefully (and the UI says so) when one is missing.
# All values are read server-side only and never sent to the browser.

# --- LLM (query expansion, title/abstract translation, abstract summaries) ---
# Without this, only your original query is searched and translation is disabled.
ANTHROPIC_API_KEY=
# LLM_MODEL_FAST=claude-haiku-5-5      # query expansion + translation
# LLM_MODEL_SUMMARY=claude-sonnet-5-5  # abstract summaries

# --- OpenAlex (primary scholarly metadata source) ---
# Strongly recommended. Free key: https://openalex.org/settings/api
# Without a key, all keyless users on your network share a $0.10/day budget (~100 searches).
# Each Babel Scholar search uses up to 5 OpenAlex searches (one per language).
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# --- Crossref (optional supplementary source; original query only) ---
CROSSREF_ENABLED=false
CROSSREF_MAILTO=

# --- Multilingual embeddings (local; downloads ~120 MB on first run) ---
EMBEDDINGS_ENABLED=true
# EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_CACHE_DIR=.cache/models
